{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "let:angel",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:npc"
    },
    "component_groups": {
      "let_despawn": {
        "minecraft:instant_despawn": {}
      },
      "skin_0": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "skin_1": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "skin_2": {
        "minecraft:variant": {
          "value": 2
        }
      },
      "skin_3": {
        "minecraft:variant": {
          "value": 3
        }
      },
      "skin_4": {
        "minecraft:variant": {
          "value": 4
        }
      },
      "fly_on": {
        "minecraft:navigation.generic": {},
        "minecraft:movement.basic": {},
        "minecraft:movement": {
          "value": 0.02
        },
        "minecraft:behavior.float_wander": {
          "priority": 2,
          "must_reach": true
        },
        "minecraft:timer": {
          "randomInterval": true,
          "time": [3.0, 5.0],
          "looping": false,
          "time_down_event": {
            "event": "fly:timer",
            "target": "self"
          }
        }
      },
      "fly_timer": {
        "minecraft:timer": {
          "randomInterval": true,
          "time": [15.0, 20.0],
          "looping": false,
          "time_down_event": {
            "event": "fly:on",
            "target": "self"
          }
        }
      },
      "chat_off": {
        "minecraft:mark_variant": {
          "value": 0
        }
      },
      "chat_on": {
        "minecraft:mark_variant": {
          "value": 1
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["angel"]
      },
      "minecraft:nameable": {
        "allow_name_tag_renaming": false,
        "always_show": false
      },
      "minecraft:npc": {
        "npc_data": {
          "picker_offsets": {
            "translate": [0, 20, 0],
            "scale": [1.7, 1.7, 1.7]
          },
          "skin_list": [
            {
              "variant": 0
            },
            {
              "variant": 1
            },
            {
              "variant": 2
            },
            {
              "variant": 3
            },
            {
              "variant": 4
            }
          ]
        }
      },
      "minecraft:custom_hit_test": {
        "hitboxes": [
          {
            "width": 1,
            "height": 1.9,
            "pivot": [0, 1, 0]
          }
        ]
      },
      "minecraft:collision_box": {
        "width": 1,
        "height": 1.9
      },
      "minecraft:physics": {},
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      },
      "minecraft:behavior.look_at_player": {
        "look_distance": 16,
        "target_distance": 10,
        "look_time": [0.1, 0.1],
        "priority": 1,
        "probability": 1
      },
      "minecraft:behavior.random_look_around": {
        "priority": 5,
        "look_time": [5, 8]
      },
      "minecraft:jump.static": {},
      "minecraft:can_fly": {},
      "minecraft:leashable": {
        "soft_distance": 20.0,
        "hard_distance": 23.0,
        "max_distance": 30.0,
        "on_leash": {
          "event": "tempt:on",
          "target": "self"
        }
      }
    },
    "events": {
      "let:despawn": {
        "add": {
          "component_groups": ["let_despawn"]
        }
      },
      "skin_0": {
        "add": {
          "component_groups": ["skin_0"]
        }
      },
      "skin_1": {
        "add": {
          "component_groups": ["skin_1"]
        }
      },
      "skin_2": {
        "add": {
          "component_groups": ["skin_2"]
        }
      },
      "skin_3": {
        "add": {
          "component_groups": ["skin_3"]
        }
      },
      "skin_4": {
        "add": {
          "component_groups": ["skin_4"]
        }
      },
      "fly:on": {
        "add": {
          "component_groups": ["fly_on"]
        },
        "queue_command": { "command": "say fly on" }
      },
      "fly:off": {
        "remove": {
          "component_groups": ["fly_on"]
        }
      },
      "fly:timer": {
        "remove": {
          "component_groups": ["fly_on"]
        },
        "add": {
          "component_groups": ["fly_timer"]
        },
        "queue_command": { "command": "say fly timer" }
      },
      "chat_off": {
        "add": {
          "component_groups": ["chat_off"]
        }
      },
      "chat_on": {
        "add": {
          "component_groups": ["chat_on"]
        }
      }
    }
  }
}
