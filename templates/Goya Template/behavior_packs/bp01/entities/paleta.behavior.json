        "has_collision": true
      },
      "minecraft:pushable": {
        "is_pushable": false
      },
      "minecraft:push_through": {
        "value": 1
      },
      "minecraft:type_family": {
        "family": ["item_angel"]
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      },
      "minecraft:interact": {
        "interactions": [
          {
            "swing": true,
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_variant",
                    "subject": "self",
                    "operator": "==",
                    "value": 1
                  }
                ]
              },
              "event": "picked"
            }
          }
