      "sparks_on": {
        "add": {
          "component_groups": ["sparks_on"]
        }
      },
      "sparks_off": {
        "add": {
          "component_groups": ["sparks_off"]
        }
      },
      "picked": {
        "queue_command": {
          "command": ["give @a let:paleta", "dialoge change @e[tag=angel_artista] angel_artista_01_b @a", "event entity @s let:despawn"]
