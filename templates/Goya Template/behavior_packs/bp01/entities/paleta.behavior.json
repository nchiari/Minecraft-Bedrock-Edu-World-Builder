{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "let:paleta",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "let_despawn": {
        "minecraft:instant_despawn": {}
      },
      "sparks_off": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "sparks_on": {
        "minecraft:variant": {
          "value": 1
        }
      }
    },
    "components": {
