        "minecraft:entity_sensor": {
          "subsensors": [
            {
              "range": 128,
              "cooldown": -1,
              "require_all": false,
              "event_filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "light_marker"
                  }
                ]
              },
              "event": "goya_light_on"
            }
          ]
        }
      },
      "goya_nubes": {
        "minecraft:entity_sensor": {
          "subsensors": [
