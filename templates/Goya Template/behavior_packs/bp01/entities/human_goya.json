          "component_groups": ["goya_timer_light"]
        },
        "remove": {
          "component_groups": ["goya_light"]
        }
      },
      "goya_light_off": {
        "queue_command": { "command": ["dialogue change @s goya_14 @a", "dialogue open @s @p goya_14"] }
      },
      "goya_nubes_idle": {
        "add": {
          "component_groups": ["goya_nubes"]
        }
      },
      "goya_nubes_on": {
        "add": {
          "component_groups": ["goya_timer_nubes"]
        },
        "remove": {
          "component_groups": ["goya_nubes"]
        }
      },
      "goya_nubes_off": {
        "queue_command": { "command": ["dialogue change @s goya_26_c @a", "dialogue open @s @p goya_26_c"] }
      }
