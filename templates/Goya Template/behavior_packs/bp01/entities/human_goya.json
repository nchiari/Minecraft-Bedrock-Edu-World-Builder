          "component_groups": ["follow"]
        }
      },
      "skin_0": {
        "add": {
          "component_groups": ["skin_0"]
        },
        "remove": {
          "component_groups": ["skin_1"]
        }
      },
      "skin_1": {
        "queue_command": {
          "command": [
            "particle let:sparks_round_2 ~~1~",
            "particle let:sparks_round_2 ~~1~",
            "particle let:sparks_round_2 ~~~",
            "particle let:sparks_round_2 ~~~",
            "particle let:sparks_edificios",
            "event entity @s skin_final"
          ]
        }
      },
      "skin_final": {
        "add": {
          "component_groups": ["skin_1"]
        },
        "remove": {
          "component_groups": ["skin_0"]
        }
      },
      "chat_off": {
        "add": {
          "component_groups": ["chat_off"]
        }
      },
      "chat_on": {
        "add": {
          "component_groups": ["chat_on"]
        }
      },
