              "range": 128,
              "cooldown": -1,
              "require_all": false,
              "event_filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "block_marker"
                  }
                ]
              },
              "event": "goya_nubes_on"
            }
          ]
        }
      },
      "goya_timer_light": {
        "minecraft:timer": {
          "time": 0.5,
          "looping": false,
          "time_down_event": {
            "event": "goya_light_off",
            "target": "self"
          }
        }
      },
      "goya_timer_nubes": {
        "minecraft:timer": {
