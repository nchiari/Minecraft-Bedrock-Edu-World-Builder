{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.pincel": {
      "initial_state": "hold_first_person",
      "states": {
        "hold_first_person": {
          "animations": ["hold_first_person"],
          "transitions": [
            { "hold_third_person": "context.is_first_person == 0.0" },
            {
              "swing_fp": "(q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_light') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_ink') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_block') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_red') ||  q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_yellow') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_blue') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_green') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_orange') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_purple') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_memory')) && q.is_using_item && !q.property('player:delay')"
            }
          ]
        },
        "hold_third_person": {
          "animations": ["hold_third_person"],
          "transitions": [
            { "hold_first_person": "context.is_first_person == 1.0" },
            {
              "swing_tp": "(q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_light') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_ink') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_block') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_red') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_yellow') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_blue') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_green') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_orange') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_purple') || q.is_item_name_any('slot.weapon.mainhand', 'let:pincel_memory')) && q.is_using_item && !q.property('player:delay')"
            }
          ]
        },
        "swing_fp": {
          "animations": ["swing_fp"],
          "transitions": [
            {
              "hold_first_person": "!query.is_using_item && q.all_animations_finished"
            }
          ]
        },
        "swing_tp": {
          "animations": ["swing_tp"],
          "transitions": [
            {
              "hold_third_person": "!query.is_using_item && q.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
